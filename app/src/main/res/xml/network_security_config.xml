<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- 允许 localhost 明文（本地 Ollama 等） -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
    </domain-config>
    <!-- TLS 证书固定：OpenAI API (DigiCert Global Root G2) -->
    <domain-config>
        <domain includeSubdomains="true">api.openai.com</domain>
        <pin-set expiration="2027-01-01">
            <!-- DigiCert Global Root G2 -->
            <pin digest="SHA-256">i7WTqTvh0OioIruIfFR4kMPnBqrS2rdiVPl/s2uC/CY=</pin>
            <!-- DigiCert SHA2 High Assurance Server CA (backup) -->
            <pin digest="SHA-256">SZQLN3pq1RFHL6FXjxAkCb+8yHic2kr8KyuZkLGih/M=</pin>
        </pin-set>
    </domain-config>
    <domain-config>
        <domain includeSubdomains="true">api.anthropic.com</domain>
        <pin-set expiration="2027-01-01">
            <!-- DigiCert Global Root G2 -->
            <pin digest="SHA-256">i7WTqTvh0OioIruIfFR4kMPnBqrS2rdiVPl/s2uC/CY=</pin>
            <pin digest="SHA-256">SZQLN3pq1RFHL6FXjxAkCb+8yHic2kr8KyuZkLGih/M=</pin>
        </pin-set>
    </domain-config>
    <domain-config>
        <domain includeSubdomains="true">generativelanguage.googleapis.com</domain>
        <pin-set expiration="2027-01-01">
            <!-- GTS Root R1 (Google) -->
            <pin digest="SHA-256">hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</pin>
            <!-- GTS CA 1C3 (backup) -->
            <pin digest="SHA-256">pF7B0LkGMJIBYiU7xB/hfB5sA7t9FkJ3OhBmY/HjOSE=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
